{
  "manifest_version": 3,
  "name": "PopUp Video",
  "version": "1.0",
  "description": "Chat about any website",
  "icons": {
    "48": "icons/logo-48.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "scripts": ["nostr.bundle.js", "sql-wasm.js", "service-worker.js"]
  },
  "content_security_policy": {
    "extension_pages": "worker-src 'self'; script-src 'self' 'wasm-unsafe-eval'"
  },
  "content_scripts": [
    {
       "matches": ["https://*.youtube.com/*"],
       "run_at": "document_idle",
       "all_frames": true,
       "css": ["default.css", "micromodal.css"],
       "js": ["emoji-mart.js", "popperjs-core.js", "tippy.js", "micromodal.min.js", "hashicon.umd.js", "linkify.js", "base64.js", "youtube.js", "content-script.js"]
    }
  ],
  "permissions": [
    "webRequest",
    "storage",
    "unlimitedStorage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
